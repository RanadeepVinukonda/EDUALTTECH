// EduAltTech — Prisma schema (Supabase Postgres)
// Product of Setsuzoku.
//
// Two platform roles: ADMIN | USER.
// Course participation is separate: CourseParticipant.role = LEARNER | MENTOR.
// A user cannot be both LEARNER and MENTOR in the same course — enforced by
// @@unique([courseId, userId]) (one row per user per course) plus service-level
// checks inside transactions.
//
// Course → Chapter → Topic → (mentor content: Lesson / Meeting / Resource)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ParticipationRole {
  LEARNER
  MENTOR
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
}

enum LessonType {
  VIDEO
  READING
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// ────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  firstName      String
  lastName       String
  role           Role     @default(USER)
  avatarUrl      String?
  isActive       Boolean  @default(true)

  // Verification — email is the account identity; mobile is verified lazily
  // (purchase / mentor application), never during signup.
  emailVerifiedAt DateTime?
  mobile          String?
  mobileVerifiedAt DateTime?
  mobileOtpHash   String?
  mobileOtpExpiresAt DateTime?
  mobileOtpAttempts  Int    @default(0)

  // Profile — structured education, no arbitrary blobs
  dateOfBirth     DateTime?
  bio             String?
  educationLevel  String? // dropdown: School | Diploma | Bachelor | Master | PhD | Other
  institution     String?
  fieldOfStudy    String?
  gradYear        Int?

  onboardingDone  Boolean  @default(false)
  notifReadAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations     CourseParticipant[]
  applications       MentorApplication[]
  orders             Order[]
  taughtCourses      Course[]             @relation("CourseCreator")
  createdLessons     Lesson[]
  createdMeetings    LiveMeeting[]
  ownedResources     Resource[]
  conversationsLearner Conversation[]     @relation("ConversationLearner")
  conversationsMentor  Conversation[]     @relation("ConversationMentor")
  sentMessages       ConversationMessage[]
  notifications      Notification[]       @relation("NotificationRecipient")
  notificationsSent  Notification[]       @relation("NotificationSender")
  auditLogs          AuditLog[]
  createdContactMessages ContactMessage[] @relation("ContactMessageCreator")
  organizationMemberships OrganizationMembership[]
  wishlist           WishlistItem[]

  @@index([role])
}

// Email verification codes — keyed by identifier, not userId (row exists
// before the account). Code stored as sha256(`${identifier}:${code}`).
model VerificationCode {
  id         String              @id @default(cuid())
  channel    String              @default("email")
  identifier String // email address
  codeHash   String
  attempts   Int                 @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime            @default(now())

  @@index([channel, identifier])
}

// ────────────────────────────────────────────────────────────────────
// Courses — admin owns lifecycle, structure, pricing
// ────────────────────────────────────────────────────────────────────

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String
  category    String       @default("General")
  gradeLevel  String?
  thumbnailUrl String?
  pricePaise  Int          @default(0) // 0 = free; backend is always authoritative
  currency    String       @default("INR")
  status      CourseStatus @default(DRAFT)

  createdById String
  createdBy   User         @relation("CourseCreator", fields: [createdById], references: [id])

  // Roadmap shell (whole-course intro)
  roadmapTitle   String?
  roadmapSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters      Chapter[]
  topics        Topic[]
  lessons       Lesson[]
  participants  CourseParticipant[]
  meetings      LiveMeeting[]
  resources     Resource[]
  applications  MentorApplication[]
  orders        Order[]
  notifications Notification[]
  wishlist      WishlistItem[]
  conversations Conversation[]

  @@index([status, createdAt])
  @@index([category])
  @@index([createdById])
}

// Admin roadmap: Chapter → Topic. Stable explicit ordering — never insertion order.
model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics  Topic[]
  meetings LiveMeeting[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Topic {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons  Lesson[]
  meetings LiveMeeting[]
  resources Resource[]

  @@unique([chapterId, order])
  @@index([courseId])
  @@index([chapterId])
}

// Mentor-authored teaching content inside admin topics.
// Mentors teach within the syllabus — they never restructure it.
model Lesson {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  type        LessonType @default(READING)
  contentUrl  String?
  textContent String?
  isPublished Boolean    @default(true)
  order       Int
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  progress LessonProgress[]

  @@unique([topicId, order])
  @@index([courseId])
  @@index([topicId])
}

model LessonProgress {
  id            String   @id @default(cuid())
  participantId String
  participant   CourseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt   DateTime @default(now())

  @@unique([participantId, lessonId])
  @@index([lessonId])
}

// ────────────────────────────────────────────────────────────────────
// Participation — LEARNER | MENTOR, one row per user per course.
// The unique constraint IS the mentor/learner exclusivity rule.
// ────────────────────────────────────────────────────────────────────

model CourseParticipant {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ParticipationRole

  // LEARNER rows: assigned mentor (transaction-safe seat selection) + progress
  mentorUserId String?
  progressPct  Float    @default(0)
  currentTopicId String?

  // MENTOR rows: seat capacity (null → platform Setting mentor_capacity)
  capacity  Int?

  status    EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime        @default(now())
  completedAt DateTime?
  updatedAt DateTime         @updatedAt

  progress   LessonProgress[]

  @@unique([courseId, userId])
  @@index([userId, role])
  @@index([courseId, role])
  @@index([mentorUserId])
}

// ────────────────────────────────────────────────────────────────────
// Mentor applications — course-specific, state machine enforced server-side
// ────────────────────────────────────────────────────────────────────

model MentorApplication {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status   ApplicationStatus @default(SUBMITTED)

  // Spec fields: qualification + resume; "why fit" optional.
  qualification String
  resumePath    String? // private bucket object key
  message       String?

  // Interview flow (admin fills when scheduling)
  interviewUrl String?
  interviewAt  DateTime?

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([status])
  @@index([courseId])
}

// ────────────────────────────────────────────────────────────────────
// Meetings & resources (mentor content)
// ────────────────────────────────────────────────────────────────────

model LiveMeeting {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title       String
  description String?
  scheduledAt DateTime
  durationMin Int      @default(60)
  meetingUrl  String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([courseId, scheduledAt])
  @@index([topicId])
}

// File/link attachments. Private files live in the private bucket behind
// storagePath and are served via short-lived signed URLs — never public URLs.
model Resource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  kind          String   @default("pdf") // pdf | doc | slides | video | link | image
  url           String? // external link (kind = link) or resolved public asset
  storagePath   String? // private bucket object key (uploads)
  fileSizeBytes Int?
  mimeType      String?
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId       String?
  topic         Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  downloads     Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@index([courseId])
  @@index([topicId])
}

// ────────────────────────────────────────────────────────────────────
// Chat — course-aware learner ↔ mentor only
// ────────────────────────────────────────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learnerUserId String
  learner       User     @relation("ConversationLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  mentorUserId  String
  mentor        User     @relation("ConversationMentor", fields: [mentorUserId], references: [id], onDelete: Cascade)
  title         String?
  createdAt     DateTime @default(now())

  messages      ConversationMessage[]

  @@unique([courseId, learnerUserId])
  @@index([mentorUserId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// Notifications & audit
// ────────────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  title       String
  body        String
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([courseId])
}

// Important admin actions. actorId nullable + SetNull: deactivating a user
// must never destroy the audit trail.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// ────────────────────────────────────────────────────────────────────
// Payments — Razorpay, server-authoritative, order snapshots course price
// ────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id])
  amountPaise     Int // snapshot of Course.pricePaise at purchase time — immutable
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  idempotencyKey  String?     @unique
  razorpayOrderId String      @unique
  receiptUrl      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayPaymentId String   @unique
  signature         String
  method            String?
  verified          Boolean  @default(false)
  rawPayload        Json?
  createdAt         DateTime @default(now())

  @@index([orderId])
}

// Append-only webhook trail — never mutated.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String    @unique
  eventType   String
  signature   String
  processed   Boolean   @default(false)
  processedAt DateTime?
  payload     Json
  receivedAt  DateTime  @default(now())
}

// ────────────────────────────────────────────────────────────────────
// Misc — wishlist, contact, settings
// ────────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  body        String
  handledById String?
  handler     User?    @relation("ContactMessageCreator", fields: [handledById], references: [id], onDelete: SetNull)
  isRead      Boolean  @default(false)
  handledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([isRead, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────
// Public website CMS — media, work, partners, team, programs
// ────────────────────────────────────────────────────────────────────

enum OrganizationType {
  SCHOOL
  PARTNER
  FRANCHISE
  NGO
  OTHER
}

model Organization {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  type         OrganizationType @default(PARTNER)
  summary      String?
  description  String?
  logoUrl      String?
  websiteUrl   String?
  contactEmail String?
  isPublished  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members  OrganizationMembership[]
  workItems WorkItem[]
  programs  Program[]

  @@index([type, isPublished])
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// Reusable asset: logos, covers, screenshots, marketing media.
// kind: image | video | logo | screenshot
// category: SCHOOL | FRANCHISE | NGO | OTHER | SCHOOLS | DIGITAL | MARKETING
// position: named homepage slot (hero, proof-feature, …)
model MediaAsset {
  id        String   @id @default(cuid())
  alt       String?
  url       String
  kind      String   @default("image")
  category  String?
  position  String?
  createdAt DateTime @default(now())

  @@index([kind, category])
}

model WorkItem {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String
  body           String?
  category       String   @default("Digital Solution")
  coverUrl       String?
  mediaIds       Json     @default("[]") // [MediaAsset.id]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([isPublished, publishedAt])
}

model Program {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String
  body           String?
  pricePaise     Int?
  currency       String   @default("INR")
  coverUrl       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([isPublished])
}
