# ─── Server ────────────────────────────────────────────────────────
NODE_ENV=
PORT=
APP_ORIGIN=
APP_BASE_URL=
BACKEND_ORIGIN=
LOG_LEVEL=

# ─── Database (Supabase Postgres) ──────────────────────────────────
# Required. Pooler URL (6543, pgbouncer=true) for runtime; direct URL (5432) for prisma migrate.
DATABASE_URL=
DIRECT_URL=

# ─── Supabase (Auth + Storage) ─────────────────────────────────────
# Required: Project → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=
SUPABASE_PUBLIC_BUCKET=
SUPABASE_STORAGE_BUCKET=                        # legacy — no longer read

# ─── Auth / OTP bypass ─────────────────────────────────────────────
# Default ON when NODE_ENV !== production. Production: leave unset/"false".
AUTH_SKIP_OTP=

# ─── Razorpay (payments) ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Twilio (phone OTP + SMS notifications) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ─── Upload limits (bytes) ─────────────────────────────────────────
MAX_UPLOAD_BYTES=
QUOTA_PER_USER_BYTES=

# ─── Seed: admin user (prisma/seed.ts) ─────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ─── Legacy — present in old .env, no longer read by code ─────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_MODEL=
