# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:3000

# ── Database (Supabase Postgres) ───────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
# Use the POOLER url (port 6543) for serverless/managed deploys with pgbouncer=true;
# use the DIRECT url (port 5432) for `prisma migrate dev`.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Razorpay (payments) ────────────────────────────────────────────
# Dashboard → Settings → API Keys (test mode works the same).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI assistant (plug in your provider later) ─────────────────────
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_MODEL=

# ── Supabase (Auth + Storage) ───────────────────────────────────────
# Project → Settings → API.
#   SUPABASE_URL:             Project URL
#   SUPABASE_ANON_KEY:        public "anon" key (safe in the browser)
#   SUPABASE_SERVICE_ROLE_KEY server-only, NEVER shipped to the client
# Auth handles signup/login/email-verification; Storage handles uploads.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resources

# ── Upload limits (bytes) ───────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400            # 25 MB per file
QUOTA_PER_USER_BYTES=104857600       # 100 MB lifetime per user

# ── Email (Resend) ─────────────────────────────────────────────────
# Used for phone-OTP fallback and application-update notifications.
# Auth verification emails are sent BY SUPABASE via its built-in SMTP —
# in Supabase: Authentication → SMTP → enable + use your Resend SMTP
# credentials (smtp.resend.com:465). No Resend key here is fine.
# https://resend.com/api-keys — EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM="Edu-Alt-Tech <info@edualttech.com>"

# Public URL of the frontend — used to build verification links.
APP_BASE_URL=http://localhost:3000

# ── Misc ───────────────────────────────────────────────────────────
LOG_LEVEL=info
