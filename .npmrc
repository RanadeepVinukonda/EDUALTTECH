# Render sets NODE_ENV=production for Node services. npm then omits
# devDependencies, which removes typescript / prisma / @types/* and makes
# `tsc` fail with "TS2688: Cannot find type definition file for 'node'".
# Include dev dependencies so `npm install` can always build the workspace.
# CLI flags (e.g. `npm ci --omit=dev`) still take precedence over this file.
include=dev
