# Backend API base (browser calls go through the /backend proxy in dev)
NEXT_PUBLIC_API_BASE=http://localhost:3000/backend

# Supabase — same project as the backend. Both are public keys.
# Dashboard → Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

