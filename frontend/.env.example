# API base the browser calls (Next rewrites proxy /backend → backend in dev)
NEXT_PUBLIC_API_BASE=

# Supabase — same project as backend. Both public keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend origin used by next.config.ts rewrites (server-side only)
BACKEND_ORIGIN=

# Public site URL — used for metadataBase / canonical links (server-side)
APP_BASE_URL=

# Maintenance mode. "true" rewrites every page to /maintenance.
# Never set on the frontend host unless the backend maintenance gate is also on.
MAINTENANCE_MODE=

# Unlock token for maintenance mode (staff only). The browser gets a derived
# cookie via POST /api/maintenance — this value must match the backend.
MAINTENANCE_TOKEN=
