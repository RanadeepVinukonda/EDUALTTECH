# ─── Public site URL ───────────────────────────────────────────────
# Canonical origin of the deployed frontend (e.g. https://www.edualttech.com).
# The backend uses this value for CORS (APP_ORIGIN/APP_BASE_URL).
APP_BASE_URL=

# ─── Backend origin ────────────────────────────────────────────────
# Absolute URL of the backend API. Required in production.
# Used by server components (server-api.ts) and the dev-only /backend proxy.
# e.g. https://edualttech.onrender.com
BACKEND_ORIGIN=

# ─── Browser API base (PUBLIC — visible in the client bundle) ──────
# Base URL the browser client (lib/api.ts) calls. In development it may be
# left as "/backend" to use the Next.js proxy; in production it MUST be the
# absolute backend URL, e.g. https://edualttech.onrender.com
# (the /backend proxy only exists when NODE_ENV=development).
NEXT_PUBLIC_API_BASE=

# ─── Supabase (PUBLIC — the anon key is browser-safe) ──────────────
# NEVER put the Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Maintenance mode ──────────────────────────────────────────────
# "true" rewrites every page to /maintenance.
# Never set on the frontend host unless the backend maintenance gate is also on.
MAINTENANCE_MODE=

# Unlock token for maintenance mode (staff only). The browser gets a derived
# cookie via GET /api/maintenance. Must match the backend MAINTENANCE_TOKEN.
MAINTENANCE_TOKEN=
